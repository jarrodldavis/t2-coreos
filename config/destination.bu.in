variant: fcos
version: 1.7.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - @@SSH_KEY@@

boot_device:
  luks:
    discard: true
    tang:
      - url: @@TANG_URL@@
        thumbprint: @@TANG_THUMBPRINT@@
        advertisement: @@TANG_ADVERTISEMENT@@

storage:
  links:
    - path: /etc/localtime
      target: @@TIMEZONE_TARGET@@
      overwrite: true

  disks:
    - device: /dev/disk/by-id/coreos-boot-disk
      partitions:
        - number: 4
          label: root
          size_mib: 0
          resize: true

  directories:
    - path: /var/lib/firmware/brcm
      mode: 0755

  trees:
    - local: rootfs
      path: /

kernel_arguments:
  should_exist:
    - console=tty1
    - rd.vconsole.font=latarcyrheb-sun32
    - intel_iommu=on
    - iommu=pt
    - mem_sleep_default=s2idle
    - firmware_class.path=/var/lib/firmware
    - rd.neednet=1
    - ip=dhcp
    - rd.net.dns-backend=systemd-resolved

systemd:
  units:
    - name: t2-enablement.service
      enabled: true
    - name: t2-lid-display.service
      enabled: true
    - name: t2-cincinnati-filter.service
      enabled: true
