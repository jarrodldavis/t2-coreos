variant: fcos
version: 1.7.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - @@SSH_KEY@@

boot_device:
  luks:
    discard: true
    tang:
      - url: @@TANG_URL@@
        thumbprint: @@TANG_THUMBPRINT@@
        advertisement: @@TANG_ADVERTISEMENT@@

storage:
  disks:
    - device: /dev/disk/by-id/coreos-boot-disk
      partitions:
        - number: 4
          label: root
          size_mib: 0
          resize: true

  directories:
    - path: /var/lib/firmware/brcm
      mode: 0755

  trees:
    - local: rootfs
      path: /

  files:
    - path: /etc/hostname
      mode: 0644
@@OPTIONAL_STORAGE_FILES@@

kernel_arguments:
  should_exist:
    - intel_iommu=on
    - iommu=pt
    - mem_sleep_default=s2idle
    - firmware_class.path=/var/lib/firmware
@@OPTIONAL_KERNEL_ARGUMENTS@@

systemd:
  units:
    - name: t2-enablement.service
      enabled: true
