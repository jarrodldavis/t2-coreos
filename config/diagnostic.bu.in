variant: fcos
version: 1.7.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - @@SSH_KEY@@

storage:
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: @@HOSTNAME@@

systemd:
  units:
    - name: sshd.service
      enabled: true
@@OPTIONAL_SYSTEMD_UNITS@@
