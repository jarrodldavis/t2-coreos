#!/usr/bin/env python3

import argparse
import base64
import hashlib
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent

COPR_OWNER = "sharpenedblade"
COPR_PROJECT = "t2linux"
COPR_BASE = f"https://download.copr.fedorainfracloud.org/results/{COPR_OWNER}/{COPR_PROJECT}"
COPR_REPO = f"copr:copr.fedorainfracloud.org:{COPR_OWNER}:{COPR_PROJECT}"

BUTANE_IMG = "quay.io/coreos/butane:release"
INSTALLER_IMG = "quay.io/coreos/coreos-installer:release"
RPMBUILD_IMG = "registry.fedoraproject.org/fedora:44"
DEFAULT_T2_PACKAGES = ["t2fanrd", "tiny-dfr", "t2linux-audio"]


def log(message: str) -> None:
    print(f"\033[1;34m==>\033[0m {message}")


def die(message: str) -> None:
    print(f"\033[1;31merror:\033[0m {message}", file=sys.stderr)
    raise SystemExit(1)


def require_command(command: str, message: str) -> None:
    if shutil.which(command) is None:
        die(message)


def render(path: Path, replacements: dict[str, str]) -> str:
    text = path.read_text()
    for name, value in replacements.items():
        text = text.replace(f"@@{name}@@", value)

    if "@@" in text:
        die(f"unresolved template placeholder in {path}")
    return text


def copy_tree(source: Path, destination: Path) -> None:
    shutil.copytree(source, destination, dirs_exist_ok=True)


def read_ssh_key(value: str) -> str:
    path = Path(value).expanduser()
    if path.is_file():
        value = path.read_text()

    key = value.splitlines()[0] if value else ""
    if not (key.startswith("ssh-") or key.startswith("ecdsa-")):
        die("--ssh-key does not look like a public key")
    return key


def write_enablement_config(path: Path, t2_packages: list[str], tang_mdns: bool) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    packages = " ".join(t2_packages)
    path.write_text(
        f"COPR_REPO={json.dumps(COPR_REPO)}\n"
        f"T2_PKGS={json.dumps(packages)}\n"
        f"TANG_MDNS={1 if tang_mdns else 0}\n"
    )


def build_dracut_rpm(staging: Path, *, native: bool) -> Path:
    topdir = staging / "rpmbuild"
    sources = topdir / "SOURCES"
    specs = topdir / "SPECS"
    sources.mkdir(parents=True)
    specs.mkdir(parents=True)

    shutil.copyfile(ROOT / "files/dracut/50coreos-sysusers/module-setup.sh", sources / "module-setup.sh")
    spec = specs / "t2-coreos-dracut.spec"
    shutil.copyfile(ROOT / "packaging/t2-coreos-dracut.spec", spec)

    if native:
        require_command("rpmbuild", "rpmbuild not found (omit --native to build the helper RPM with Podman)")
        subprocess.run(["rpmbuild", "--define", f"_topdir {topdir}", "-bb", str(spec)], check=True)
    else:
        subprocess.run(
            [
                "podman", "run", "--rm", "--security-opt", "label=disable",
                "-v", f"{topdir}:/work:z", "-w", "/work", RPMBUILD_IMG,
                "bash", "-lc",
                "dnf -qy install rpm-build && rpmbuild --define '_topdir /work' -bb SPECS/t2-coreos-dracut.spec",
            ],
            check=True,
        )

    rpms = list((topdir / "RPMS/noarch").glob("t2-coreos-dracut-*.noarch.rpm"))
    if len(rpms) != 1:
        die("did not produce exactly one t2-coreos-dracut helper RPM")
    return rpms[0]


def fetch(url: str) -> bytes:
    result = subprocess.run(["curl", "-fsSL", url], check=False, stdout=subprocess.PIPE)
    if result.returncode != 0:
        die(f"could not fetch {url}")
    return result.stdout


def decode_base64url(value: str) -> bytes:
    return base64.urlsafe_b64decode(value + "=" * (-len(value) % 4))


def jwk_thumbprint(jwk: dict[str, object]) -> str:
    kty = jwk.get("kty")
    members_by_type = {
        "EC": ("crv", "kty", "x", "y"),
        "OKP": ("crv", "kty", "x"),
        "RSA": ("e", "kty", "n"),
    }
    members = members_by_type.get(kty)
    if members is None or any(name not in jwk for name in members):
        die(f"unsupported Tang signing-key type: {kty!r}")

    canonical = json.dumps({name: jwk[name] for name in members}, separators=(",", ":"), sort_keys=True).encode()
    digest = hashlib.sha256(canonical).digest()
    return base64.urlsafe_b64encode(digest).rstrip(b"=").decode()


def fetch_tang_advertisement(url: str) -> tuple[str, list[str]]:
    advertisement_url = f"{url.rstrip('/')}/adv"
    try:
        advertisement = json.loads(fetch(advertisement_url))
        payload = json.loads(decode_base64url(advertisement["payload"]))
        keys = payload["keys"]
    except (KeyError, TypeError, ValueError, json.JSONDecodeError) as error:
        die(f"invalid Tang advertisement from {advertisement_url}: {error}")

    signing_keys = []
    for key in keys:
        key_ops = key.get("key_ops", [])
        algorithm = key.get("alg", "")
        if "verify" in key_ops or key.get("use") == "sig" or algorithm.startswith(("ES", "RS", "PS")) or algorithm == "EdDSA":
            signing_keys.append(key)

    if not signing_keys:
        die(f"Tang advertisement from {advertisement_url} contains no signing keys")

    thumbprints = sorted({jwk_thumbprint(key) for key in signing_keys})
    return json.dumps(advertisement, separators=(",", ":")), thumbprints


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Build Fedora CoreOS installer or diagnostic live ISOs for an Intel T2 Mac")
    parser.add_argument("--ssh-key", required=True, help="public key file or literal public key")
    parser.add_argument("--diagnostic", action="store_true", help="build a non-installing diagnostic live ISO")
    parser.add_argument("--disk", default="/dev/nvme0n1", help="automatic installation target")
    parser.add_argument("--stream", choices=("stable", "testing", "next"), default="stable", help="Fedora CoreOS stream")
    parser.add_argument("--hostname", help="hostname; defaults to t2mac or t2-coreos-live in diagnostic mode")
    parser.add_argument("--out-dir", type=Path, default=Path("out"), help="build and staging directory")

    parser.add_argument("--tang-url", help="Tang server URL (required for installer builds)")
    parser.add_argument("--tang-thumbprint", help="trusted Tang signing-key thumbprint; auto-discovered if omitted")
    parser.add_argument("--tang-mdns", choices=("auto", "on", "off"), default="auto")

    parser.add_argument(
        "--t2-package",
        action="append",
        dest="t2_packages",
        metavar="PACKAGE",
        help="T2 userspace package to layer; repeat to replace the default package set",
    )
    parser.add_argument("--live-karg", action="append", default=[], metavar="ARG", help="extra live-environment kernel argument")
    parser.add_argument("--live-debug-shell", action=argparse.BooleanOptionalAction, default=True)
    parser.add_argument(
        "--diagnostic-console-log",
        action=argparse.BooleanOptionalAction,
        default=False,
        help="follow the live journal on tty8 in diagnostic mode",
    )
    parser.add_argument("--copr-gpg-key", type=Path, help="local t2linux COPR public key")
    parser.add_argument("--native", action="store_true", help="use native Butane/coreos-installer instead of Podman")
    return parser.parse_args()

def main() -> None:
    args = parse_args()
    hostname = args.hostname or ("t2-coreos-live" if args.diagnostic else "t2mac")

    if args.diagnostic_console_log and not args.diagnostic:
        die("--diagnostic-console-log requires --diagnostic")
    if not args.diagnostic and not args.tang_url:
        die("--tang-url is required for installer builds")
    if args.tang_thumbprint and not args.tang_url:
        die("--tang-thumbprint requires --tang-url")

    if not args.diagnostic:
        require_command("curl", "curl not found")
    if args.native:
        require_command("butane", "butane not found (omit --native to use Podman)")
        require_command("coreos-installer", "coreos-installer not found")
    else:
        require_command("podman", "podman not found (or use --native)")

    ssh_key = read_ssh_key(args.ssh_key)
    out_setting = args.out_dir.expanduser()
    out_setting.mkdir(parents=True, exist_ok=True)
    out_dir = out_setting.resolve()
    staging = out_dir / "staging"
    if staging.exists():
        shutil.rmtree(staging)
    staging.mkdir(mode=0o700)

    if args.native:
        stage_arg = str(staging)
        out_arg = str(out_dir)

        def run_butane(command_args: list[str], *, stdout=None) -> None:
            subprocess.run(["butane", *command_args], check=True, stdout=stdout)

        def run_installer(command_args: list[str], *, stdout=None) -> None:
            subprocess.run(["coreos-installer", *command_args], check=True, stdout=stdout)
    else:
        stage_arg = "/out/staging"
        out_arg = "/out"

        def run_butane(command_args: list[str], *, stdout=None) -> None:
            subprocess.run(
                [
                    "podman", "run", "--rm", "-i", "--security-opt", "label=disable",
                    "-v", f"{out_dir}:/out:z", "-w", stage_arg, BUTANE_IMG, *command_args,
                ],
                check=True,
                stdout=stdout,
            )

        def run_installer(command_args: list[str], *, stdout=None) -> None:
            subprocess.run(
                [
                    "podman", "run", "--rm", "-i", "--security-opt", "label=disable", "--pull=always",
                    "-v", f"{out_dir}:/out:z", "-w", stage_arg, INSTALLER_IMG, *command_args,
                ],
                check=True,
                stdout=stdout,
            )

    log(f"Downloading Fedora CoreOS {args.stream} live ISO")
    run_installer(["download", "-s", args.stream, "-p", "metal", "-f", "iso", "-C", out_arg])

    images = list(out_dir.glob("fedora-coreos-*-live*.iso"))
    if not images:
        die("coreos-installer download did not produce a live ISO")
    base_iso = max(images, key=lambda path: path.stat().st_mtime)
    log(f"Base image: {base_iso.name}")

    if args.diagnostic:
        console_unit = ""
        if args.diagnostic_console_log:
            console_unit = (ROOT / "config/fragments/diagnostic-console-log.bu").read_text().rstrip()

        rendered_butane = render(
            ROOT / "config/diagnostic.bu.in",
            {
                "SSH_KEY": json.dumps(ssh_key),
                "HOSTNAME": json.dumps(hostname),
                "OPTIONAL_SYSTEMD_UNITS": console_unit,
            },
        )
        butane_path = staging / "diagnostic.bu"
        ignition_path = staging / "diagnostic.ign"
        butane_path.write_text(rendered_butane)

        log("Transpiling diagnostic Butane -> Ignition")
        with ignition_path.open("wb") as output:
            run_butane(["--strict", f"{stage_arg}/diagnostic.bu"], stdout=output)
        if ignition_path.stat().st_size == 0:
            die("butane produced an empty diagnostic config")

        output_iso = out_dir / "t2-coreos-diagnostic.iso"
        output_iso.unlink(missing_ok=True)
        customize_args = [
            "iso", "customize",
            "--live-ignition", f"{stage_arg}/diagnostic.ign",
            "-o", f"{out_arg}/{output_iso.name}",
        ]
        for karg in args.live_karg:
            customize_args += ["--live-karg-append", karg]
        if args.live_debug_shell:
            customize_args += ["--live-karg-append", "systemd.debug_shell=1"]
        customize_args.append(f"{out_arg}/{base_iso.name}")

        log("Building diagnostic live ISO")
        run_installer(customize_args)

        print()
        log("Done")
        print()
        print(f"  ISO:    {out_setting / output_iso.name}")
        print(f"  Stage:  {out_setting / 'staging'}")
        print(f"  Host:   {hostname}")
        print("  Install: disabled")
        print()
        print(f"Write it with:  sudo dd if={out_setting / output_iso.name} of=/dev/diskN bs=4M status=progress oflag=direct")
        return

    tang_mdns = args.tang_mdns == "on" or (args.tang_mdns == "auto" and ".local" in args.tang_url)

    t2_packages = list(args.t2_packages or DEFAULT_T2_PACKAGES)
    if tang_mdns and "systemd-resolved" not in t2_packages:
        t2_packages.append("systemd-resolved")

    log(f"Fetching Tang advertisement from {args.tang_url}")
    tang_advertisement, thumbprints = fetch_tang_advertisement(args.tang_url)
    tang_thumbprint = args.tang_thumbprint
    if tang_thumbprint:
        if tang_thumbprint not in thumbprints:
            die("--tang-thumbprint does not match a signing key in the Tang advertisement")
    else:
        tang_thumbprint = thumbprints[0]
        log(f"Tang signing-key thumbprint (trust on first use): {tang_thumbprint}")
        if len(thumbprints) > 1:
            log(f"Advertisement contains {len(thumbprints)} signing keys; using the first thumbprint")

    files_dir = staging / "files"
    rootfs = files_dir / "rootfs"
    rootfs.mkdir(parents=True)
    os.chmod(files_dir, 0o700)

    copy_tree(ROOT / "files/common", rootfs)
    if tang_mdns:
        copy_tree(ROOT / "files/mdns", rootfs)

    (rootfs / "etc").mkdir(parents=True, exist_ok=True)
    (rootfs / "etc/hostname").write_text(f"{hostname}\n")

    repo_path = rootfs / "etc/yum.repos.d/t2linux.repo"
    repo_path.parent.mkdir(parents=True, exist_ok=True)
    repo_path.write_text(
        render(
            ROOT / "templates/t2linux.repo.in",
            {
                "COPR_OWNER": COPR_OWNER,
                "COPR_PROJECT": COPR_PROJECT,
                "COPR_BASE": COPR_BASE,
            },
        )
    )

    write_enablement_config(rootfs / "etc/t2-coreos/t2-enablement.conf", t2_packages, tang_mdns)

    if tang_mdns:
        log("Building Fedora CoreOS dracut sysusers helper RPM")
        helper_rpm = build_dracut_rpm(staging, native=args.native)
        helper_target = rootfs / "etc/t2-coreos/t2-coreos-dracut.rpm"
        helper_target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(helper_rpm, helper_target)

    gpg_path = rootfs / "etc/pki/rpm-gpg/RPM-GPG-KEY-t2linux"
    gpg_path.parent.mkdir(parents=True, exist_ok=True)
    if args.copr_gpg_key:
        gpg_source = args.copr_gpg_key.expanduser()
        log(f"Using COPR signing key from {gpg_source}")
        shutil.copyfile(gpg_source, gpg_path)
    else:
        log("Fetching t2linux COPR signing key")
        gpg_path.write_bytes(fetch(f"{COPR_BASE}/pubkey.gpg"))

    if "BEGIN PGP PUBLIC KEY" not in gpg_path.read_text(errors="replace"):
        die("COPR key file does not look like an ASCII-armored PGP key")

    storage_files = []

    rendered_butane = render(
        ROOT / "config/destination.bu.in",
        {
            "SSH_KEY": json.dumps(ssh_key),
            "TANG_URL": json.dumps(args.tang_url),
            "TANG_THUMBPRINT": json.dumps(tang_thumbprint),
            "TANG_ADVERTISEMENT": json.dumps(tang_advertisement),
            "OPTIONAL_STORAGE_FILES": "\n".join(storage_files),
            "OPTIONAL_KERNEL_ARGUMENTS": (
                "    - rd.neednet=1\n"
                "    - ip=dhcp\n"
                "    - rd.net.dns-backend=systemd-resolved"
                if tang_mdns
                else ""
            ),
        },
    )

    butane_output = out_dir / "t2-fcos.bu"
    butane_output.write_text(rendered_butane)
    config_bu = staging / "config.bu"
    config_bu.write_text(rendered_butane)

    pre_install = render(ROOT / "installer/pre-install.sh.in", {"DISK": args.disk})
    pre_install_path = staging / "pre-install.sh"
    pre_install_path.write_text(pre_install)
    os.chmod(pre_install_path, 0o755)

    ignition_path = staging / "config.ign"
    log("Transpiling destination Butane -> Ignition")
    with ignition_path.open("wb") as output:
        run_butane(["--strict", "--files-dir", f"{stage_arg}/files", f"{stage_arg}/config.bu"], stdout=output)
    if ignition_path.stat().st_size == 0:
        die("butane produced an empty destination config")

    output_iso = out_dir / "t2-coreos-installer.iso"
    output_iso.unlink(missing_ok=True)
    customize_args = [
        "iso", "customize",
        "--dest-ignition", f"{stage_arg}/config.ign",
        "--dest-device", args.disk,
        "--pre-install", f"{stage_arg}/pre-install.sh",
        "--live-karg-append", "rd.driver.blacklist=applesmc",
        "--live-karg-append", "modprobe.blacklist=applesmc",
        "-o", f"{out_arg}/{output_iso.name}",
    ]
    for karg in args.live_karg:
        customize_args += ["--live-karg-append", karg]
    if args.live_debug_shell:
        customize_args += ["--live-karg-append", "systemd.debug_shell=1"]
    customize_args.append(f"{out_arg}/{base_iso.name}")

    log(f"Building self-installing ISO (target: {args.disk})")
    run_installer(customize_args)

    print()
    log("Done")
    print()
    print(f"  ISO:    {out_setting / output_iso.name}")
    print(f"  Config: {out_setting / 't2-fcos.bu'}")
    print(f"  Stage:  {out_setting / 'staging'}")
    print(f"  Target: {args.disk}      -- WILL BE ERASED WITHOUT PROMPTING")
    luks_summary = f"Tang at {args.tang_url}"
    if tang_mdns:
        luks_summary += " (mDNS resolver in initramfs)"
    print(f"  LUKS:   {luks_summary}")
    print()
    print(f"Write it with:  sudo dd if={out_setting / output_iso.name} of=/dev/diskN bs=4M status=progress oflag=direct")

if __name__ == "__main__":
    main()
