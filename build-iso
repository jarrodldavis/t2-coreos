#!/usr/bin/env python3

import argparse
import base64
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
from urllib.parse import urlencode

ROOT = Path(__file__).resolve().parent

COPR_OWNER = "sharpenedblade"
COPR_PROJECT = "t2linux"
COPR_BASE = f"https://download.copr.fedorainfracloud.org/results/{COPR_OWNER}/{COPR_PROJECT}"
COPR_REPO = f"copr:copr.fedorainfracloud.org:{COPR_OWNER}:{COPR_PROJECT}"
COPR_API = "https://copr.fedorainfracloud.org/api_3/project"
FCOS_BUILD_BASE = "https://builds.coreos.fedoraproject.org/prod/streams"
BUTANE_IMG = "quay.io/coreos/butane:release"
INSTALLER_IMG = "quay.io/coreos/coreos-installer:release"
DEFAULT_T2_PACKAGES = ["t2fanrd", "tiny-dfr", "t2linux-audio", "systemd-resolved"]


@dataclass(frozen=True)
class FcosRelease:
    version: str
    fedora_major: int
    stream: str

    @property
    def iso_url(self) -> str:
        filename = f"fedora-coreos-{self.version}-live-iso.x86_64.iso"
        return f"{FCOS_BUILD_BASE}/{self.stream}/builds/{self.version}/x86_64/{filename}"


@dataclass(frozen=True)
class BuildPaths:
    out_setting: Path
    out_dir: Path
    staging: Path

    @property
    def stage_arg(self) -> str:
        return "/out/staging"

    @property
    def out_arg(self) -> str:
        return "/out"


def log(message: str) -> None:
    print(f"\033[1;34m==>\033[0m {message}")


def die(message: str) -> None:
    print(f"\033[1;31merror:\033[0m {message}", file=sys.stderr)
    raise SystemExit(1)


def require_command(command: str) -> None:
    if shutil.which(command) is None:
        die(f"{command} not found")


def render(path: Path, replacements: dict[str, str]) -> str:
    text = path.read_text()
    for name, value in replacements.items():
        text = text.replace(f"@@{name}@@", value)

    if "@@" in text:
        die(f"unresolved template placeholder in {path}")
    return text


def copy_tree(source: Path, destination: Path) -> None:
    shutil.copytree(source, destination, dirs_exist_ok=True)


def detect_builder_timezone() -> str:
    localtime = Path("/etc/localtime")
    try:
        resolved = localtime.resolve(strict=True)
        zoneinfo = Path("/usr/share/zoneinfo")
        try:
            timezone = str(resolved.relative_to(zoneinfo))
            ZoneInfo(timezone)
            return timezone
        except ValueError:
            pass
    except OSError:
        pass

    timezone_file = Path("/etc/timezone")
    if timezone_file.is_file():
        timezone = timezone_file.read_text().strip()
        if timezone:
            try:
                ZoneInfo(timezone)
                return timezone
            except (ZoneInfoNotFoundError, ValueError):
                pass

    if shutil.which("timedatectl"):
        result = subprocess.run(
            ["timedatectl", "show", "--property=Timezone", "--value"],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        timezone = result.stdout.strip()
        if result.returncode == 0 and timezone:
            try:
                ZoneInfo(timezone)
                return timezone
            except (ZoneInfoNotFoundError, ValueError):
                pass

    die("could not determine builder timezone; specify --timezone")


def validate_timezone(timezone: str) -> str:
    try:
        ZoneInfo(timezone)
    except (ZoneInfoNotFoundError, ValueError):
        die(f"unknown IANA timezone: {timezone}")
    return timezone


def read_ssh_key(value: str) -> str:
    path = Path(value).expanduser()
    if path.is_file():
        value = path.read_text()

    key = value.splitlines()[0] if value else ""
    if not (key.startswith("ssh-") or key.startswith("ecdsa-")):
        die("--ssh-key does not look like a public key")
    return key


def fetch(url: str, headers: dict[str, str] | None = None) -> bytes:
    command = ["curl", "-fsSL"]
    for name, value in (headers or {}).items():
        command.extend(["-H", f"{name}: {value}"])
    command.append(url)
    result = subprocess.run(command, check=False, stdout=subprocess.PIPE)
    if result.returncode != 0:
        die(f"could not fetch {url}")
    return result.stdout


def fetch_json(url: str, headers: dict[str, str] | None = None) -> object:
    try:
        return json.loads(fetch(url, headers))
    except json.JSONDecodeError as error:
        die(f"invalid JSON from {url}: {error}")


def collect_matching_strings(value: object, pattern: re.Pattern[str]) -> set[str]:
    matches: set[str] = set()

    if isinstance(value, str):
        matches.update(match.group(0) for match in pattern.finditer(value))
    elif isinstance(value, list):
        for item in value:
            matches.update(collect_matching_strings(item, pattern))
    elif isinstance(value, dict):
        for key, item in value.items():
            matches.update(collect_matching_strings(key, pattern))
            matches.update(collect_matching_strings(item, pattern))

    return matches


def get_copr_fedora_majors() -> set[int]:
    query = urlencode({"ownername": COPR_OWNER, "projectname": COPR_PROJECT})
    project = fetch_json(f"{COPR_API}?{query}")
    if not isinstance(project, dict):
        die("COPR project API returned an unexpected response")

    pattern = re.compile(r"fedora-(\d+)-x86_64")
    declared = {
        int(match.split("-", 2)[1])
        for field in ("chroots", "chroot_repos")
        for match in collect_matching_strings(project.get(field), pattern)
    }
    if not declared:
        die(f"COPR {COPR_OWNER}/{COPR_PROJECT} declares no Fedora x86_64 chroots")
    return declared


def fcos_fedora_major(version: str) -> int:
    major, separator, _ = version.partition(".")
    if not separator or not major.isdigit():
        die(f"unexpected Fedora CoreOS version: {version!r}")
    return int(major)


def get_fcos_releases(stream: str) -> list[str]:
    index = fetch_json(f"{FCOS_BUILD_BASE}/{stream}/releases.json")
    if not isinstance(index, dict) or index.get("stream") != stream:
        die("Fedora CoreOS release index returned an unexpected response")

    releases = index.get("releases")
    if not isinstance(releases, list) or not releases:
        die(f"Fedora CoreOS {stream} release index contains no releases")

    versions = []
    for release in releases:
        if not isinstance(release, dict) or not isinstance(release.get("version"), str):
            die("Fedora CoreOS release index contains an invalid release entry")
        versions.append(release["version"])
    return versions


def select_fcos_release(stream: str, supported_majors: set[int]) -> FcosRelease:
    for version in reversed(get_fcos_releases(stream)):
        fedora_major = fcos_fedora_major(version)
        if fedora_major in supported_majors:
            return FcosRelease(version, fedora_major, stream)

    majors = ", ".join(str(major) for major in sorted(supported_majors))
    die(f"no Fedora CoreOS {stream} release matches T2 COPR Fedora chroots: {majors}")


def decode_base64url(value: str) -> bytes:
    return base64.urlsafe_b64decode(value + "=" * (-len(value) % 4))


def jwk_thumbprint(jwk: dict[str, object]) -> str:
    members_by_type = {
        "EC": ("crv", "kty", "x", "y"),
        "OKP": ("crv", "kty", "x"),
        "RSA": ("e", "kty", "n"),
    }
    kty = jwk.get("kty")
    members = members_by_type.get(kty)
    if members is None or any(name not in jwk for name in members):
        die(f"unsupported Tang signing-key type: {kty!r}")

    canonical = json.dumps({name: jwk[name] for name in members}, separators=(",", ":"), sort_keys=True).encode()
    digest = hashlib.sha256(canonical).digest()
    return base64.urlsafe_b64encode(digest).rstrip(b"=").decode()


def fetch_tang_advertisement(url: str) -> tuple[str, str]:
    advertisement_url = f"{url.rstrip('/')}/adv"
    try:
        advertisement = json.loads(fetch(advertisement_url))
        payload = json.loads(decode_base64url(advertisement["payload"]))
        keys = payload["keys"]
    except (KeyError, TypeError, ValueError, json.JSONDecodeError) as error:
        die(f"invalid Tang advertisement from {advertisement_url}: {error}")

    signing_keys = []
    for key in keys:
        key_ops = key.get("key_ops", [])
        algorithm = key.get("alg", "")
        if "verify" in key_ops or key.get("use") == "sig" or algorithm.startswith(("ES", "RS", "PS")) or algorithm == "EdDSA":
            signing_keys.append(key)

    if not signing_keys:
        die(f"Tang advertisement from {advertisement_url} contains no signing keys")

    thumbprints = sorted({jwk_thumbprint(key) for key in signing_keys})
    if len(thumbprints) != 1:
        die(f"Tang advertisement from {advertisement_url} contains {len(thumbprints)} signing keys; cannot choose automatically")

    return json.dumps(advertisement, separators=(",", ":")), thumbprints[0]


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Build a self-installing Fedora CoreOS ISO for an Intel T2 Mac")
    parser.add_argument("--ssh-key", required=True, help="public key file or literal public key")
    parser.add_argument("--tang-url", required=True, help="Tang server URL")
    parser.add_argument("--disk", default="/dev/nvme0n1", help="automatic installation target")
    parser.add_argument("--stream", choices=("stable", "testing", "next"), default="stable", help="Fedora CoreOS stream")
    parser.add_argument("--hostname", default="t2mac", help="installed hostname")
    parser.add_argument("--timezone", help="installed IANA timezone; defaults to the builder system timezone")
    parser.add_argument("--out-dir", type=Path, default=Path("out"), help="build and staging directory")
    parser.add_argument(
        "--t2-package",
        action="append",
        dest="t2_packages",
        metavar="PACKAGE",
        help="T2 userspace package to layer; repeat to replace the default package set",
    )
    parser.add_argument("--live-karg", action="append", default=[], metavar="ARG", help="extra live-environment kernel argument")
    return parser.parse_args()


def prepare_paths(out_setting: Path) -> BuildPaths:
    out_setting = out_setting.expanduser()
    out_setting.mkdir(parents=True, exist_ok=True)
    out_dir = out_setting.resolve()
    staging = out_dir / "staging"
    if staging.exists():
        shutil.rmtree(staging)
    staging.mkdir(mode=0o700)
    return BuildPaths(out_setting, out_dir, staging)


def run_container(
    paths: BuildPaths, image: str, command: list[str], *, stdout=None, pull: bool = False
) -> subprocess.CompletedProcess:
    args = ["podman", "run", "--rm"]
    args += ["--security-opt", "label=disable"]
    if pull:
        args.append("--pull=always")
    args += ["-v", f"{paths.out_dir}:/out:z", "-w", paths.stage_arg, image, *command]
    return subprocess.run(args, check=True, stdout=stdout)


def run_butane(paths: BuildPaths, command: list[str], *, stdout=None) -> None:
    run_container(paths, BUTANE_IMG, command, stdout=stdout)


def run_installer(paths: BuildPaths, command: list[str], *, stdout=None) -> None:
    run_container(paths, INSTALLER_IMG, command, stdout=stdout, pull=True)


def download_base_iso(paths: BuildPaths, release: FcosRelease) -> Path:
    filename = Path(release.iso_url).name
    base_iso = paths.out_dir / filename

    if base_iso.is_file():
        log(f"Using cached Fedora CoreOS ISO: {base_iso.name}")
        return base_iso

    log(f"Downloading Fedora CoreOS ISO: {base_iso.name}")
    run_installer(paths, ["download", "--image-url", release.iso_url, "-C", paths.out_arg])
    if not base_iso.is_file():
        die(f"coreos-installer download did not produce {filename}")

    return base_iso


def build_dracut_rpm(paths: BuildPaths, fedora_major: int) -> Path:
    topdir = paths.staging / "rpmbuild"
    sources = topdir / "SOURCES"
    specs = topdir / "SPECS"
    sources.mkdir(parents=True)
    specs.mkdir(parents=True)

    shutil.copyfile(ROOT / "files/dracut/50coreos-sysusers/module-setup.sh", sources / "module-setup.sh")
    shutil.copyfile(ROOT / "packaging/t2-coreos-dracut.spec", specs / "t2-coreos-dracut.spec")

    run_container(
        paths,
        f"registry.fedoraproject.org/fedora:{fedora_major}",
        [
            "bash",
            "-lc",
            "dnf -qy install rpm-build && "
            "rpmbuild --define '_topdir /out/staging/rpmbuild' -bb /out/staging/rpmbuild/SPECS/t2-coreos-dracut.spec",
        ],
    )

    rpms = list((topdir / "RPMS/noarch").glob("t2-coreos-dracut-*.noarch.rpm"))
    if len(rpms) != 1:
        die("did not produce exactly one t2-coreos-dracut helper RPM")
    return rpms[0]


def write_enablement_config(path: Path, t2_packages: list[str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(f"COPR_REPO={json.dumps(COPR_REPO)}\nT2_PKGS={json.dumps(' '.join(t2_packages))}\n")


def prepare_rootfs(paths: BuildPaths, hostname: str, t2_packages: list[str], release: FcosRelease) -> Path:
    rootfs = paths.staging / "files/rootfs"
    rootfs.mkdir(parents=True)
    os.chmod(paths.staging / "files", 0o700)
    copy_tree(ROOT / "files/common", rootfs)

    (rootfs / "etc/hostname").write_text(f"{hostname}\n")

    repo_path = rootfs / "etc/yum.repos.d/t2linux.repo"
    repo_path.parent.mkdir(parents=True, exist_ok=True)
    repo_path.write_text(
        render(
            ROOT / "templates/t2linux.repo.in",
            {"COPR_OWNER": COPR_OWNER, "COPR_PROJECT": COPR_PROJECT, "COPR_BASE": COPR_BASE},
        )
    )

    write_enablement_config(rootfs / "etc/t2-coreos/t2-enablement.conf", t2_packages)

    log("Building dracut helper RPM")
    helper_rpm = build_dracut_rpm(paths, release.fedora_major)
    helper_target = rootfs / "etc/t2-coreos/t2-coreos-dracut.rpm"
    helper_target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(helper_rpm, helper_target)

    gpg_path = rootfs / "etc/pki/rpm-gpg/RPM-GPG-KEY-t2linux"
    gpg_path.parent.mkdir(parents=True, exist_ok=True)
    gpg_path.write_bytes(fetch(f"{COPR_BASE}/pubkey.gpg"))
    if "BEGIN PGP PUBLIC KEY" not in gpg_path.read_text(errors="replace"):
        die("COPR key file does not look like an ASCII-armored PGP key")

    return rootfs


def transpile_butane(paths: BuildPaths, template: Path, output_name: str, replacements: dict[str, str], *, files_dir: bool = False) -> Path:
    bu_path = paths.staging / f"{output_name}.bu"
    ign_path = paths.staging / f"{output_name}.ign"
    bu_path.write_text(render(template, replacements))

    command = ["--strict"]
    if files_dir:
        command += ["--files-dir", f"{paths.stage_arg}/files"]
    command.append(f"{paths.stage_arg}/{bu_path.name}")

    with ign_path.open("wb") as output:
        run_butane(paths, command, stdout=output)
    if ign_path.stat().st_size == 0:
        die(f"butane produced an empty {output_name} config")
    return ign_path


def build_configs(
    paths: BuildPaths, ssh_key: str, tang_url: str, tang_advertisement: str, tang_thumbprint: str, timezone: str
) -> tuple[Path, Path]:
    destination_ign = transpile_butane(
        paths,
        ROOT / "config/destination.bu.in",
        "config",
        {
            "SSH_KEY": json.dumps(ssh_key),
            "TANG_URL": json.dumps(tang_url),
            "TANG_THUMBPRINT": json.dumps(tang_thumbprint),
            "TANG_ADVERTISEMENT": json.dumps(tang_advertisement),
            "TIMEZONE_TARGET": json.dumps(f"/usr/share/zoneinfo/{timezone}"),
        },
        files_dir=True,
    )
    shutil.copyfile(paths.staging / "config.bu", paths.out_dir / "t2-fcos.bu")

    live_ign = transpile_butane(
        paths,
        ROOT / "config/live.bu.in",
        "live",
        {"SSH_KEY": json.dumps(ssh_key)},
    )
    return destination_ign, live_ign


def build_installer_iso(paths: BuildPaths, base_iso: Path, disk: str, destination_ign: Path, live_ign: Path, live_kargs: list[str]) -> Path:
    pre_install_path = paths.staging / "pre-install.sh"
    pre_install_path.write_text(render(ROOT / "installer/pre-install.sh.in", {"DISK": disk}))
    os.chmod(pre_install_path, 0o755)

    output_iso = paths.out_dir / "t2-coreos-installer.iso"
    output_iso.unlink(missing_ok=True)
    customize_args = [
        "iso", "customize",
        "--live-ignition", f"{paths.stage_arg}/{live_ign.name}",
        "--dest-ignition", f"{paths.stage_arg}/{destination_ign.name}",
        "--dest-device", disk,
        "--pre-install", f"{paths.stage_arg}/pre-install.sh",
        "--live-karg-append", "rd.driver.blacklist=applesmc",
        "--live-karg-append", "modprobe.blacklist=applesmc",
        "--live-karg-append", "console=tty1",
        "--live-karg-append", "rd.vconsole.font=latarcyrheb-sun32",
        "--live-karg-append", "systemd.debug_shell=1",
        "--dest-karg-append", "console=tty1",
        "--dest-karg-append", "rd.vconsole.font=latarcyrheb-sun32",
        "-o", f"{paths.out_arg}/{output_iso.name}",
    ]
    for karg in live_kargs:
        customize_args += ["--live-karg-append", karg]
    customize_args.append(f"{paths.out_arg}/{base_iso.name}")

    log("Building self-installing ISO")
    run_installer(paths, customize_args)
    return output_iso


def print_summary(
    paths: BuildPaths, output_iso: Path, release: FcosRelease, disk: str, tang_url: str, tang_thumbprint: str, timezone: str
) -> None:
    print()
    print(f"  ISO:    {paths.out_setting / output_iso.name}")
    print(f"  Config: {paths.out_setting / 't2-fcos.bu'}")
    print(f"  Stage:  {paths.out_setting / 'staging'}")
    print(f"  FCOS:   {release.version} (Fedora {release.fedora_major})")
    print(f"  Target: {disk}      -- WILL BE ERASED WITHOUT PROMPTING")
    print(f"  TZ:     {timezone}")
    print(f"  LUKS:   Tang at {tang_url} (mDNS resolver in initramfs)")
    print(f"  Tang:   {tang_thumbprint}")
    print()
    print(f"Write it with:  sudo dd if={paths.out_setting / output_iso.name} of=/dev/diskN bs=4M status=progress oflag=direct")


def main() -> None:
    args = parse_args()
    require_command("podman")
    require_command("curl")

    paths = prepare_paths(args.out_dir)
    ssh_key = read_ssh_key(args.ssh_key)
    timezone = validate_timezone(args.timezone) if args.timezone else detect_builder_timezone()
    t2_packages = list(args.t2_packages or DEFAULT_T2_PACKAGES)
    if "systemd-resolved" not in t2_packages:
        t2_packages.append("systemd-resolved")

    log("Fetching Tang advertisement")
    tang_advertisement, tang_thumbprint = fetch_tang_advertisement(args.tang_url)

    supported_majors = get_copr_fedora_majors()
    release = select_fcos_release(args.stream, supported_majors)
    log(f"Using Fedora CoreOS {release.version} (Fedora {release.fedora_major})")

    base_iso = download_base_iso(paths, release)
    prepare_rootfs(paths, args.hostname, t2_packages, release)

    destination_ign, live_ign = build_configs(
        paths, ssh_key, args.tang_url, tang_advertisement, tang_thumbprint, timezone
    )
    output_iso = build_installer_iso(paths, base_iso, args.disk, destination_ign, live_ign, args.live_karg)
    print_summary(paths, output_iso, release, args.disk, args.tang_url, tang_thumbprint, timezone)


if __name__ == "__main__":
    main()
