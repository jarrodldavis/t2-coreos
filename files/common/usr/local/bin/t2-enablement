#!/bin/bash
set -euo pipefail

source /etc/t2-coreos/t2-enablement.conf

systemctl stop zincati.service || true

if [[ "$TANG_MDNS" == 1 ]]; then
    rpm-ostree install -y /etc/t2-coreos/t2-coreos-dracut.rpm
fi

rpm-ostree override replace \
    --experimental \
    --from repo="$COPR_REPO" \
    kernel kernel-core kernel-modules kernel-modules-core kernel-modules-extra

read -r -a packages <<< "$T2_PKGS"
if ((${#packages[@]})); then
    rpm-ostree install -y "${packages[@]}"
fi

initramfs_args=(--enable)
if [[ "$TANG_MDNS" == 1 ]]; then
    initramfs_args+=(--arg=-I --arg=/etc/nsswitch.conf)
fi
rpm-ostree initramfs "${initramfs_args[@]}"

touch /var/lib/t2-enablement.stamp
