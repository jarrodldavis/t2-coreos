#!/usr/bin/python3

import json
import re
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.error import HTTPError, URLError
from urllib.parse import urlencode, urlsplit
from urllib.request import Request, urlopen

COPR_OWNER = "sharpenedblade"
COPR_PROJECT = "t2linux"
COPR_API = "https://copr.fedorainfracloud.org/api_3/project"
UPSTREAM = "https://updates.coreos.fedoraproject.org"
LISTEN = ("127.0.0.1", 8079)


def fetch_json(url: str) -> object:
    request = Request(url, headers={"Accept": "application/json", "User-Agent": "t2-cincinnati-filter/1"})
    with urlopen(request, timeout=30) as response:
        return json.load(response)


def collect_matching_strings(value: object, pattern: re.Pattern[str]) -> set[str]:
    matches: set[str] = set()

    if isinstance(value, str):
        matches.update(match.group(0) for match in pattern.finditer(value))
    elif isinstance(value, list):
        for item in value:
            matches.update(collect_matching_strings(item, pattern))
    elif isinstance(value, dict):
        for key, item in value.items():
            matches.update(collect_matching_strings(key, pattern))
            matches.update(collect_matching_strings(item, pattern))

    return matches


def get_copr_fedora_majors() -> set[int]:
    query = urlencode({"ownername": COPR_OWNER, "projectname": COPR_PROJECT})
    project = fetch_json(f"{COPR_API}?{query}")
    if not isinstance(project, dict):
        raise ValueError("COPR project API returned an unexpected response")

    pattern = re.compile(r"fedora-(\d+)-x86_64")
    majors = {
        int(match.split("-", 2)[1])
        for field in ("chroots", "chroot_repos")
        for match in collect_matching_strings(project.get(field), pattern)
    }
    if not majors:
        raise ValueError(f"COPR {COPR_OWNER}/{COPR_PROJECT} declares no Fedora x86_64 chroots")
    return majors


def fcos_fedora_major(version: str) -> int:
    major, separator, _ = version.partition(".")
    if not separator or not major.isdigit():
        raise ValueError(f"unexpected Fedora CoreOS version: {version!r}")
    return int(major)


def graph_size(graph: object) -> tuple[int, int]:
    if not isinstance(graph, dict):
        raise ValueError("Cincinnati returned a non-object graph")
    nodes = graph.get("nodes")
    edges = graph.get("edges")
    if not isinstance(nodes, list) or not isinstance(edges, list):
        raise ValueError("Cincinnati graph is missing nodes or edges")
    return len(nodes), len(edges)


def filter_graph(graph: object, supported_majors: set[int]) -> dict[str, object]:
    if not isinstance(graph, dict):
        raise ValueError("Cincinnati returned a non-object graph")

    nodes = graph.get("nodes")
    edges = graph.get("edges")
    if not isinstance(nodes, list) or not isinstance(edges, list):
        raise ValueError("Cincinnati graph is missing nodes or edges")

    versions = []
    for node in nodes:
        if not isinstance(node, dict) or not isinstance(node.get("version"), str):
            raise ValueError("Cincinnati graph contains an invalid node")
        versions.append(node["version"])

    filtered_edges = []
    for edge in edges:
        if (
            not isinstance(edge, list)
            or len(edge) != 2
            or not all(isinstance(index, int) and not isinstance(index, bool) for index in edge)
            or any(index < 0 or index >= len(nodes) for index in edge)
        ):
            raise ValueError("Cincinnati graph contains an invalid edge")

        if fcos_fedora_major(versions[edge[1]]) in supported_majors:
            filtered_edges.append(edge)

    filtered = dict(graph)
    filtered["edges"] = filtered_edges
    return filtered


class Handler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        print(f"request: GET {self.path}", flush=True)

        if urlsplit(self.path).path != "/v1/graph":
            self.send_error(404)
            return

        try:
            supported_majors = get_copr_fedora_majors()
            graph = fetch_json(f"{UPSTREAM}{self.path}")
            upstream_nodes, upstream_edges = graph_size(graph)
            filtered = filter_graph(graph, supported_majors)
            filtered_nodes, filtered_edges = graph_size(filtered)
            majors = ", ".join(str(major) for major in sorted(supported_majors))
            print(f"upstream graph: {upstream_nodes} nodes, {upstream_edges} edges", flush=True)
            print(
                f"filtered graph: {filtered_nodes} nodes, {filtered_edges} edges "
                f"({upstream_edges - filtered_edges} removed; supported Fedora: {majors})",
                flush=True,
            )
            body = json.dumps(filtered, separators=(",", ":")).encode()
        except (HTTPError, URLError, OSError, ValueError, json.JSONDecodeError) as error:
            print(f"error: {error}", file=sys.stderr, flush=True)
            self.send_error(502)
            return

        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *args: object) -> None:
        pass


if __name__ == "__main__":
    ThreadingHTTPServer(LISTEN, Handler).serve_forever()
